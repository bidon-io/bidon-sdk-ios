{
  "workspace": "BidOn.xcworkspace",
  "adapter_prefix": "BidonAdapter",
  "adapters_dir": "Adapters",
  "adapters_test_scheme": "AdaptersTests",
  "adapter_scheme_prefix": "BidonAdapter",
  "tests_dir": "Tests/AdaptersTests",
  "base_branch": "develop",
  "branch_prefix": "chore/pod-",
  "commit_prefix": "chore(pods):",
  "adapter_version_regex": "adapterVersion\\s*:\\s*String\\s*=\\s*\"(\\d+)\"",
  "adapter_changelog": true,
  "pr_labels": ["dependencies", "cocoapods"],
  "adapter_regex": "Adapters/(BidonAdapter[A-Za-z0-9_]+)",
  "mapping_api_url": "https://neo-mw-backend.appodeal.com/v4/status/all",
  "dependency_field_ios": "bidon_dependency_ios",
  "pod_to_adapter": {
    "Google-Mobile-Ads-SDK": ["BidonAdapterGoogleMobileAds", "BidonAdapterGoogleAdManager"],
    "AppLovinSDK": ["AppLovinMediationBidonAdapter"],
    "IronSourceSDK": ["ISBidonCustomAdapter"]
  }
}
